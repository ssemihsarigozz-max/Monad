# Monad Testnet only — never commit a real private key.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=
TREASURY_ADDRESS=
# Defaults to 48 hours from the latest chain block. Minimum: 86400 (24 hours).
DEPLOYMENT_DURATION_SECONDS=172800
# Optional Unix timestamps; leave blank for the duration above.
# Old explicit deadlines must be cleared or updated; each must be >=24 hours ahead.
LIBRARY_DEADLINE=
LAUNDRY_DEADLINE=
CAFETERIA_DEADLINE=
# Demo value is 2; production must be 30 or greater.
SERVICE_THRESHOLD=2
